{
  "name": "eggsoup-dsh-themes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Theme manager for the DSH web UI: Ocean, Vitesse Nyx, and Vitesse Nyx Emerald, with a dedicated Themes page in Settings",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
