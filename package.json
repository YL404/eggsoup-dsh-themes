{
  "name": "eggsoup-dsh-themes",
  "version": "0.4.0",
  "type": "module",
  "description": "Theme manager for the DSH web UI: Ocean plus the fifteen-theme Nyx dark series (Vitesse, Vitesse Emerald, Catppuccin Mocha, Lilac Soft, Visual Studio Dark, Neutral Slate, Inkstone Xuanmo, Inkstone Canghai, Misty Teal, Aurora, Verdant Soft, Fields of the Shire, Gruvbox, Flexoki Dark, OpenChamber), with preview cards on a dedicated Themes page in Settings",
  "license": "MIT",
  "author": "eggsoup (https://github.com/YL404)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YL404/eggsoup-dsh-themes.git"
  },
  "homepage": "https://github.com/YL404/eggsoup-dsh-themes#readme",
  "bugs": {
    "url": "https://github.com/YL404/eggsoup-dsh-themes/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "themes",
    "eggsoup"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
